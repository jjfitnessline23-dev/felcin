<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Felcin</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Felcin reads your heart rate, distance, and workout data to display your run stats.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Felcin saves your running workouts to Apple Health.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Felcin uses your location to draw your route on the map during a workout.</string>
    <key>NSMotionUsageDescription</key>
    <string>Felcin counts your steps during walking workouts.</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.felcin.app</string>
    <key>WKApplication</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>9.0</string>
    <key>WATCH_SYNC_SECRET</key>
    <string>$(WATCH_SYNC_SECRET)</string>
</dict>
</plist>