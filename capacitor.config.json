{
  "appId": "com.felcin.app",
  "appName": "Felcin",
  "webDir": "../felcin-next/out",
  "ios": {
    "scheme": "Felcin",
    "backgroundColor": "#000000",
    "contentInset": "never"
  },
  "android": {
    "backgroundColor": "#000000"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
