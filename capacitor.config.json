{
  "appId": "app.felcin.social",
  "appName": "Felcin",
  "webDir": "www",
  "server": {
    "url": "https://www.felcin.com",
    "cleartext": false
  },
  "ios": {
    "scheme": "Felcin",
    "backgroundColor": "#000000",
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": true
  },
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "buildOptions": {
      "releaseType": "AAB"
    }
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "apple.com"]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#7C3AED"
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#000000"
    },
    "Keyboard": {
      "resize": "none"
    },
    "Camera": {
      "presentationStyle": "popover"
    },
    "App": {
      "allowNavigation": ["felcin.com", "www.felcin.com"]
    }
  }
}
