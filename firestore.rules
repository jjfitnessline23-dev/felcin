rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profileDoc(userId) {
      return get(/databases/$(database)/documents/userProfiles/$(userId));
    }

    function isBootstrapAdmin() {
      return request.auth != null && request.auth.token.email == 'johnjeannis@gmail.com';
    }

    function isAdmin() {
      return request.auth != null && (
        isBootstrapAdmin() ||
        profileDoc(request.auth.uid).data.role == 'admin'
      );
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if isAdmin();
    }

    match /users/{userId}/posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    match /users/{userId}/posts/{postId}/likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == likeId;
    }

    match /users/{userId}/posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
    }

    match /users/{userId}/following/{followedUserId} {
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    match /users/{userId}/followers/{followerId} {
      allow create, delete: if request.auth != null && request.auth.uid == followerId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    match /privateChats/{chatId} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
